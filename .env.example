# Copy to .env and fill in, or export these in your shell. Without them the chain uses the local
# file ledger and everything still works. .env is gitignored and never committed.
#
# Run schema.sql once in your project's SQL editor first.

# SUPABASE_URL=https://your-project.supabase.co

# The service role key bypasses row level security, which is exactly why it lives here and never
# in a browser, a URL, or this repository. Server side only.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Defaults to the demo workspace seeded by schema.sql.
# SIGNAL_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
